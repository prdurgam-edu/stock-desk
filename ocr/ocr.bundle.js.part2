            } else if (e1.PolyTyp != e2.PolyTyp) {
              if (e1.WindDelta === 0 && Math.abs(e2.WindCnt) == 1 && (this.m_ClipType != ClipperLib.ClipType.ctUnion || e2.WindCnt2 === 0)) {
                this.AddOutPt(e1, pt2);
                if (e1Contributing)
                  e1.OutIdx = -1;
