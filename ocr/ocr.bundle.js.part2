          return true;
        else if (Pt2a.X > Pt1a.X == Pt2a.X < Pt1b.X)
          return true;
        else if (Pt2b.X > Pt1a.X == Pt2b.X < Pt1b.X)
          return true;
        else if (Pt1a.X == Pt2a.X && Pt1b.X == Pt2b.X)
